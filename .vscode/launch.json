<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grand Cafeteria</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600&family=Oswald:wght@600&display=swap" rel="stylesheet">

    <!-- Styles -->
    <link rel="stylesheet" href="css/all.min.css">
    <link rel="stylesheet" href="css/tailwind.css">
    <link rel="stylesheet" href="css/tooplate-antique-cafe.css">
</head>

<body>

<!-- ================= INTRO ================= -->
<div id="intro" class="parallax-window" data-parallax="scroll" data-image-src="img/antique-cafe-bg-01.jpg">
    <nav id="tm-nav" class="fixed w-full">
        <div class="tm-container mx-auto px-2 md:py-6 text-right">
            <button class="md:hidden py-2 px-2" id="menu-toggle">
                <i class="fas fa-2x fa-bars tm-text-gold"></i>
            </button>
            <ul class="mb-3 md:mb-0 text-2xl font-normal flex justify-end flex-col md:flex-row">
                <li class="mx-4"><a href="#intro" class="tm-text-gold">Intro</a></li>
                <li class="mx-4"><a href="#menu" class="tm-text-gold">Menu</a></li>
                <li class="mx-4"><a href="#about" class="tm-text-gold">About</a></li>
                <li class="mx-4"><a href="#contact" class="tm-text-gold">Contact</a></li>
            </ul>
        </div>
    </nav>

    <div class="container mx-auto px-2 tm-intro-width py-32 text-center">
        <div class="bg-black bg-opacity-70 p-12 mb-5">
            <h1 class="text-white text-5xl tm-logo-font mb-4">Grand Cafeteria</h1>
            <p class="tm-text-gold text-2xl">Our coffee is better than your ex ☕</p>
        </div>
    </div>
</div>

<!-- ================= MENU ================= -->
<div id="menu" class="parallax-window" data-parallax="scroll" data-image-src="img/antique-cafe-bg-02.jpg">
    <div class="container mx-auto py-24">
        <h2 class="bg-white tm-text-brown py-6 px-12 text-4xl font-medium inline-block rounded-md mb-16">
            Our Cafe Menu
        </h2>
        <!-- (menu items unchanged – your existing HTML works) -->
    </div>
</div>

<!-- ================= ABOUT ================= -->
<div id="about" class="parallax-window" data-parallax="scroll" data-image-src="img/antique-cafe-bg-03.jpg">
    <div class="container mx-auto py-24">
        <div class="bg-white bg-opacity-80 p-12 rounded-xl">
            <h2 class="tm-text-green text-4xl mb-6">About our cafe</h2>
            <p>
                We create unique experiences that change lives and bring people back.
            </p>
        </div>
    </div>
</div>

<!-- ================= CONTACT ================= -->
<div id="contact" class="parallax-window relative" data-parallax="scroll" data-image-src="img/images.jfif">
    <div class="container mx-auto py-32 flex flex-col lg:flex-row justify-around">

        <div class="bg-white bg-opacity-80 p-10 rounded-xl w-full lg:w-1/2 mb-6">
            <h2 class="text-3xl mb-4 tm-text-green">Contact Us</h2>
            <p>Send us your message.</p>
        </div>

        <div class="bg-black bg-opacity-50 p-10 rounded-xl w-full lg:w-1/2">
            <form id="contactForm" class="text-lg">

                <input type="text" id="name"
                    class="input w-full bg-black border-b text-white py-3 mb-4"
                    placeholder="Name" required>

                <input type="email" id="email"
                    class="input w-full bg-black border-b text-white py-3 mb-4"
                    placeholder="Email" required>

                <textarea id="message" rows="5"
                    class="input w-full bg-black border-b text-white py-3 mb-4"
                    placeholder="Message" required></textarea>

                <div class="text-right">
                    <button type="submit" class="text-white hover:text-yellow-500">
                        Send it
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<!-- ================= JS ================= -->
<script src="js/jquery-3.6.0.min.js"></script>
<script src="js/parallax.min.js"></script>
<script src="js/jquery.singlePageNav.min.js"></script>

<!-- ================= FIREBASE ================= -->
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>

<script>
  const firebaseConfig = {
    apiKey: "AIzaSyBPlMEZNlEljz4nXqFdGQMHVGl5stDP5XE",
    authDomain: "grand-cafeteria.firebaseapp.com",
    projectId: "grand-cafeteria",
    storageBucket: "grand-cafeteria.firebasestorage.app",
    messagingSenderId: "295452465736",
    appId: "1:295452465736:web:685e991d81a6eb6011567d"
  };

  firebase.initializeApp(firebaseConfig);
  const db = firebase.firestore();

  document.getElementById("contactForm").addEventListener("submit", function(e) {
    e.preventDefault();

    db.collection("orders").add({
      name: name.value,
      email: email.value,
      message: message.value,
      time: firebase.firestore.FieldValue.serverTimestamp()
    })
    .then(() => {
      alert("✅ Message sent successfully!");
      contactForm.reset();
    })
    .catch(err => alert("❌ " + err.message));
  });
</script>

</body>
</html>
